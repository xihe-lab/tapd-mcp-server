{
  "name": "tapd-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build && pnpm validate:sdk-routes",
    "lint": "eslint packages/",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "generate:richtext": "tsx scripts/generate-richtext-manifests.ts",
    "validate:sdk-routes": "node scripts/validate-sdk-routes.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xihe-lab/tapd-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/xihe-lab/tapd-mcp-server/issues"
  },
  "homepage": "https://xihe-lab.com"
}
