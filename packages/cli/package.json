{
  "name": "@xihe-lab/tapd-cli",
  "version": "2.0.0-rc.1",
  "description": "TAPD command line sharing the same kernel as tapd-mcp-server",
  "type": "module",
  "bin": {
    "tapd": "./dist/bin/tapd.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "tsx src/output/formatter.test.ts && tsx src/flags.test.ts"
  },
  "keywords": [
    "tapd",
    "cli"
  ],
  "author": "xihe-lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xihe-lab/tapd-mcp-server.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@xihe-lab/tapd-core": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  }
}
