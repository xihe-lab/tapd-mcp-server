{
  "name": "@xihe-lab/tapd-core",
  "version": "1.0.0",
  "description": "Shared kernel for TAPD tools: tool definitions, TapdClient and registry, shared by CLI and MCP entries",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "tsx src/registry/registry.test.ts && tsx src/config/config.test.ts && tsx src/advisor/advisor.test.ts",
    "debug:commands": "tsx src/registry/debug-commands.ts"
  },
  "keywords": [
    "tapd",
    "sdk",
    "core"
  ],
  "author": "xihe-lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xihe-lab/tapd-mcp-server.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opentapd/tapd-node-sdk": "^1.67.0",
    "zod": "^3.24.1"
  }
}
